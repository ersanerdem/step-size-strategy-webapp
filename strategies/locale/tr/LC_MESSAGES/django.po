#: forms.py:90
msgid "Length of the interval [t₀, t₀ + a]; also the half-width of the search rectangle in t."
msgstr "[t₀, t₀ + a] aralığının uzunluğu; aynı zamanda arama dikdörtgeninin t yönündeki yarı genişliği."

#: forms.py:91
msgid "Half-width of the search rectangle around the solution."
msgstr "Çözüm etrafındaki arama dikdörtgeninin yarı genişliği."

#: forms.py:92
msgid "Minimum allowed step size. The integration stops if the step falls below it."
msgstr "İzin verilen en küçük adım uzunluğu. Adım bunun altına düşerse integrasyon durur."

#: forms.py:52
msgid "Must be greater than 0."
msgstr "0'dan büyük olmalı."

#: forms.py:111
msgid "Initial time."
msgstr "Başlangıç zamanı."

#: forms.py:112
msgid "Length of the interval [t₀, t₀ + a]."
msgstr "[t₀, t₀ + a] aralığının uzunluğu."

#: forms.py:117
msgid "Desired local error level of every step."
msgstr "Her adım için istenen yerel hata seviyesi."

#: forms.py:54
msgid "Must be at least %(min)s."
msgstr "En az %(min)s olmalı."

#: forms.py:97
msgid "Right-hand side. Use t, x, + − * / ^ and sin, cos, exp, log, sqrt …"
msgstr "Sağ taraf. t, x, + − * / ^ ve sin, cos, exp, log, sqrt … kullanabilirsiniz."

#: forms.py:100
msgid "Initial value x(t₀)."
msgstr "Başlangıç değeri x(t₀)."

#: numerics.py:82
msgid "a must be greater than 0."
msgstr "a, 0'dan büyük olmalı."

#: numerics.py:84
msgid "b must be greater than 0."
msgstr "b, 0'dan büyük olmalı."

#: numerics.py:86
msgid "h* must not be negative."
msgstr "h* negatif olamaz."

#: numerics.py:88
msgid "The error tolerance must be greater than 0."
msgstr "Hata toleransı 0'dan büyük olmalı."

#: numerics.py:127
msgid "The function is not finite on the rectangle around the current point (division by zero, logarithm of a negative number, overflow ...)."
msgstr "Fonksiyon, mevcut noktanın etrafındaki dikdörtgende sonlu değil (sıfıra bölme, negatif sayının logaritması, taşma ...)."

#: numerics.py:139
msgid "The function value is not finite at a computed point."
msgstr "Fonksiyonun değeri hesaplanan bir noktada sonlu değil."

#: numerics.py:145
msgid "The solution became infinite or undefined (the solution blows up)."
msgstr "Çözüm sonsuz ya da tanımsız oldu (çözüm patlıyor)."

#: numerics.py:150
msgid "More than %(n)d steps would be needed. Increase h*, reduce a, or increase the error tolerance."
msgstr "%(n)d adımdan fazlası gerekecek. h* değerini büyütün, a'yı küçültün ya da hata toleransını artırın."

#: numerics.py:279
msgid "Matrix and initial vector sizes do not match."
msgstr "Matris ile başlangıç vektörünün boyutları uyuşmuyor."

#: numerics.py:400
msgid "Matrix, vector and phi sizes do not match."
msgstr "Matris, vektör ve φ boyutları uyuşmuyor."

#: numerics.py:419
msgid "phi (or its derivative) is not finite at the bounding point."
msgstr "φ (ya da türevi) sınır noktasında sonlu değil."

#: numerics.py:429
msgid "phi is not finite at a computed point."
msgstr "φ hesaplanan bir noktada sonlu değil."

#: presets.py:31
msgid "Linear test problem  x' = t + x"
msgstr "Lineer test problemi  x' = t + x"

#: presets.py:32
msgid "The example used in the original papers. Exact solution: x(t) = 2eᵗ − t − 1."
msgstr "Orijinal makalelerde kullanılan örnek. Tam çözüm: x(t) = 2eᵗ − t − 1."

#: presets.py:37
msgid "Logistic population growth"
msgstr "Lojistik nüfus artışı"

#: presets.py:38
msgid "x' = x(1 − x): growth that saturates at the carrying capacity 1."
msgstr "x' = x(1 − x): taşıma kapasitesi 1'de doyuma ulaşan büyüme."

#: presets.py:43
msgid "Newton's law of cooling"
msgstr "Newton'un soğuma yasası"

#: presets.py:44
msgid "A 90 °C object in a 20 °C room: x' = −0.3 (x − 20)."
msgstr "20 °C'lik bir odada 90 °C'lik bir cisim: x' = −0.3 (x − 20)."

#: presets.py:49
msgid "Radioactive decay"
msgstr "Radyoaktif bozunma"

#: presets.py:50
msgid "x' = −0.5 x with 100 units at t = 0."
msgstr "t = 0'da 100 birim ile x' = −0.5 x."

#: presets.py:55
msgid "Riccati equation"
msgstr "Riccati denklemi"

#: presets.py:56
msgid "x' = t² + x², a classic non-linear test problem without an elementary solution."
msgstr "x' = t² + x², elementer fonksiyonlarla çözümü olmayan klasik bir lineer olmayan test problemi."

#: presets.py:61
msgid "RC circuit with sinusoidal source"
msgstr "Sinüzoidal kaynaklı RC devresi"

#: presets.py:62
msgid "Capacitor voltage: x' = cos(t) − x (RC = 1 s)."
msgstr "Kondansatör gerilimi: x' = cos(t) − x (RC = 1 s)."

#: presets.py:71
msgid "Harmonic oscillator"
msgstr "Harmonik osilatör"

#: presets.py:72
msgid "x'' + x = 0 written as a first-order system (position, velocity)."
msgstr "x'' + x = 0 denkleminin birinci mertebe sistem hâli (konum, hız)."

#: presets.py:77
msgid "Mass–spring–damper"
msgstr "Kütle–yay–sönümleyici"

#: presets.py:78
msgid "m = 1 kg, c = 0.5 N·s/m, k = 4 N/m:  x'' + 0.5 x' + 4x = 0."
msgstr "m = 1 kg, c = 0.5 N·s/m, k = 4 N/m:  x'' + 0.5 x' + 4x = 0."

#: presets.py:83
msgid "Series RLC circuit"
msgstr "Seri RLC devresi"

#: presets.py:84
msgid "L = 0.5 H, R = 1 Ω, C = 0.2 F. State: charge q and current i."
msgstr "L = 0.5 H, R = 1 Ω, C = 0.2 F. Durum: yük q ve akım i."

#: presets.py:91
msgid "Radioactive decay chain A → B → C"
msgstr "Radyoaktif bozunma zinciri A → B → C"

#: presets.py:92
msgid "k₁ = 1, k₂ = 0.5. Starts with only A."
msgstr "k₁ = 1, k₂ = 0.5. Başlangıçta yalnızca A var."

#: presets.py:100
msgid "Third-order equation"
msgstr "Üçüncü mertebe denklem"

#: presets.py:101
msgid "x''' + 3x'' + 3x' + x = 0 (critically damped), state (x, x', x'')."
msgstr "x''' + 3x'' + 3x' + x = 0 (kritik sönümlü), durum (x, x', x'')."

#: presets.py:111
msgid "Two coupled masses"
msgstr "Bağlı iki kütle"

#: presets.py:112
msgid "Two equal masses between three springs. State (x₁, x₂, v₁, v₂)."
msgstr "Üç yay arasında iki eşit kütle. Durum (x₁, x₂, v₁, v₂)."

#: presets.py:125
msgid "Damped pendulum"
msgstr "Sönümlü sarkaç"

#: presets.py:126
msgid "θ'' + 0.2θ' + sin θ = 0, starting at θ = 1 rad. Here x = θ, y = θ'."
msgstr "θ'' + 0.2θ' + sin θ = 0, θ = 1 rad'dan başlar. Burada x = θ, y = θ'."

#: presets.py:131
msgid "Lotka–Volterra predator–prey"
msgstr "Lotka–Volterra av–avcı modeli"

#: presets.py:132
msgid "x: prey, y: predator.  x' = x − 0.5xy,  y' = −0.5y + 0.25xy."
msgstr "x: av, y: avcı.  x' = x − 0.5xy,  y' = −0.5y + 0.25xy."

#: presets.py:137
msgid "Van der Pol oscillator"
msgstr "Van der Pol osilatörü"

#: presets.py:138
msgid "x'' − (1 − x²)x' + x = 0 (μ = 1), a self-sustained oscillation from electronics."
msgstr "x'' − (1 − x²)x' + x = 0 (μ = 1), elektronikten bilinen kendi kendini sürdüren bir salınım."

#: presets.py:145
msgid "SIR epidemic model"
msgstr "SIR salgın modeli"

#: presets.py:146
msgid "Fractions of susceptible (x), infected (y) and recovered (z); β = 0.5, γ = 0.1 per day."
msgstr "Duyarlı (x), enfekte (y) ve iyileşen (z) oranları; günlük β = 0.5, γ = 0.1."

#: presets.py:156
msgid "SEIR epidemic model"
msgstr "SEIR salgın modeli"

#: presets.py:157
msgid "Susceptible x, exposed y, infected z, recovered w; β = 0.5, σ = 0.2, γ = 0.1 per day."
msgstr "Duyarlı x, maruz kalan y, enfekte z, iyileşen w; günlük β = 0.5, σ = 0.2, γ = 0.1."

